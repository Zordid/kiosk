		MENUITEM "Sortier&kriterium... (EKListe)", idm_Sorting
		MENUITEM SEPARATOR
		MENUITEM "&Export...", idm_Export
		MENUITEM SEPARATOR
		MENUITEM "Horizontal / Vertikal anordnen", idm_HorzVert
	END

END
BestellMenu MENU 
BEGIN
	POPUP "&Bearbeiten"
	BEGIN
		MENUITEM "Bestellung &ansehen...", idm_Update
		MENUITEM "Bestellung &löschen...", idm_Delete
	END

	MENUITEM "Bestellung &annehmen", idm_Bestellen, GRAYED
	MENUITEM "&Faxen/Drucken", idm_Print
	MENUITEM "&Ende", idm_Ende
	MENUITEM "&Info...", idm_Info, HELP
END
