1000+id_WawisLogo BITMAP "title.bmp"
STRINGTABLE 
BEGIN
	str_Error+em_DBServerError, "Datenbankfehler:\n\n%s kann nicht geöffnet werden !"
	str_Error+em_WrongWawisIni, "Initialisationsdatei WAWIS.INI nicht gefunden oder fehlerhaft !"
	str_Error+em_DBFilesNotFound, "Datendateien nicht vollständig im Datenverzeichnis %s enthalten."
	str_Error+em_StrmFileNotFound, "Folgende Datei nicht gefunden:\n%s"
	str_Error+em_StrmCannotCreate, "Folgende Datei kann nicht angelegt werden:\n%s"
	str_Error+em_WrongIDCode, "Bestelldatei %s ist korrupt."
END
