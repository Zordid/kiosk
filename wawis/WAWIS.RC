#include "globals.inc"

MainMenu MENU 
BEGIN
	POPUP "S&ystem"
	BEGIN
		MENUITEM "&Systemeinstellungen...", IDM_SYSTEM
		MENUITEM "&Benutzereinstellungen...", IDM_USER
		MENUITEM "Datenbank neu einlesen", IDM_REREADDB, GRAYED
		MENUITEM SEPARATOR
		MENUITEM "&Drucken", IDM_PRINT, GRAYED
		MENUITEM "D&rucker einrichten...", IDM_PRINTERSETUP, GRAYED
		MENUITEM SEPARATOR
		MENUITEM "Be&enden\TAlt-X", IDM_QUIT
	END

	POPUP "&Bearbeiten"
	BEGIN
		MENUITEM "&Kopieren\TStrg-Einfg", IDM_COPY, GRAYED
		MENUITEM "&Einfügen\TShift-Einfg", IDM_PASTE, GRAYED
		MENUITEM SEPARATOR
		MENUITEM "&Alles markieren", IDM_SELECTALL, GRAYED
		MENUITEM SEPARATOR
		MENUITEM "E&xportieren...", idm_Export, GRAYED
	END

	POPUP "&Stammdaten"
	BEGIN
		MENUITEM "&Artikelstammdaten", IDM_ARTIKELSTAMM
		MENUITEM "&Lieferantenstammdaten", IDM_LIEFERANTENSTAMM
		MENUITEM "&Betriebestammdaten", IDM_BETRIEBESTAMM
		MENUITEM "&EK Liste...", IDM_EKLISTE
	END

	POPUP "&Ordersätze"
	BEGIN
		MENUITEM "&Neuer Ordersatz", idm_NewOS
		MENUITEM "Ordersatz &öffnen...", idm_OSOpen
		MENUITEM "Ordersatz &speichern", idm_OSSave, GRAYED
		MENUITEM "Ordersatz speichern &unter...", idm_OSSaveAs, GRAYED
		MENUITEM "Ordersatz &löschen...", idm_OSDelete
		MENUITEM SEPARATOR
		MENUITEM "&Aktive Ordersätze...", idm_ActiveOS
		MENUITEM "&Extra Ordersätze der Betriebe...", idm_OSExtras
	END

	MENUITEM "Bes&tellungen", idm_Bestellung
	POPUP "&Fenster"
	BEGIN
		MENUITEM "&Überlappend", 24337
		MENUITEM "&Nebeneinander", 24336
		MENUITEM "&Symbole anordnen", 24335
		MENUITEM "&Alle schließen", 24338
	END

	POPUP "&Hilfe"
	BEGIN
		MENUITEM "&Info über Wawis...", idm_Info
	END

END

